---
interface Props {
  title: string;
  description: string;
  active: "picker" | "contrast" | "oklch";
}

const { title, description, active } = Astro.props;
const menus = [
  { en: "Color picker", href: "/", id: "picker", key: "nav.picker", ko: "색상 선택기" },
  { en: "Contrast", href: "/contrast/", id: "contrast", key: "nav.contrast", ko: "명암비" },
  { en: "OKLCH", href: "/oklch/", id: "oklch", key: "nav.oklch", ko: "OKLCH" },
];
---

<!doctype html>
<html lang="ko" data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#28a8ea" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title} | Coloor</title>
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("coloor:theme") || "system";
        let resolved = theme;
        if (theme === "system") {
          resolved = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePreference = theme;
        const savedLanguage = localStorage.getItem("coloor:language");
        let language = navigator.language.toLowerCase().startsWith("ko") ? "ko" : "en";
        if (savedLanguage === "en" || savedLanguage === "ko") {
          language = savedLanguage;
        }
        document.documentElement.lang = language;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Coloor</a>
      <nav aria-label="주 메뉴">
        {menus.map((menu) => (
          <a href={menu.href} aria-current={active === menu.id ? "page" : undefined} data-i18n={menu.key} data-ko={menu.ko} data-en={menu.en}>
            {menu.ko}
          </a>
        ))}
      </nav>
      <div class="site-preferences">
        <label class="language-select">
          <span class="sr-only" data-i18n="label.language" data-ko="언어" data-en="Language">언어</span>
          <span aria-hidden="true">文A</span>
          <select id="site-language" aria-label="언어">
            <option value="ko">한국어</option>
            <option value="en">English</option>
          </select>
        </label>
        <button id="site-theme" type="button" aria-label="테마" title="테마"><span aria-hidden="true" class="theme-icon"></span><span class="sr-only theme-label">테마</span></button>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>

<script>
  import { applyTheme, getLanguage, getTheme, setLanguage } from "../utils/preferences";

  const languageSelect = document.querySelector<HTMLSelectElement>("#site-language");
  const themeButton = document.querySelector<HTMLButtonElement>("#site-theme");
  const media = matchMedia("(prefers-color-scheme: dark)");
  const themeOrder = ["system", "light", "dark"] as const;
  const labels = {
    en: { dark: "Dark theme", language: "Language", light: "Light theme", system: "System theme" },
    ko: { dark: "다크 테마", language: "언어", light: "라이트 테마", system: "시스템 테마" },
  };

  const renderLanguage = () => {
    const language = getLanguage();
    document.documentElement.lang = language;
    if (languageSelect) {
      languageSelect.value = language;
      languageSelect.ariaLabel = labels[language].language;
    }
    for (const element of document.querySelectorAll<HTMLElement>("[data-i18n]")) {
      element.textContent = element.dataset[language] ?? element.textContent;
    }
  };
  const renderTheme = () => {
    const language = getLanguage();
    const theme = getTheme();
    applyTheme(theme);
    if (themeButton) {
      const label = labels[language][theme];
      themeButton.ariaLabel = label;
      themeButton.title = label;
      const themeLabel = themeButton.querySelector<HTMLElement>(".theme-label");
      if (themeLabel) {
        themeLabel.textContent = label;
      }
    }
  };
  languageSelect?.addEventListener("change", () => {
    setLanguage(languageSelect.value === "en" ? "en" : "ko");
    renderLanguage();
    renderTheme();
  });
  themeButton?.addEventListener("click", () => {
    const current = getTheme();
    applyTheme(themeOrder[(themeOrder.indexOf(current) + 1) % themeOrder.length] ?? "system");
    renderTheme();
  });
  media.addEventListener("change", () => {
    if (getTheme() === "system") {
      renderTheme();
    }
  });
  renderLanguage();
  renderTheme();
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  :root { color-scheme: light; --site-bg: #fff; --site-text: #333; --site-border: #ddd; --site-hover: #f1f6fa; --site-active: #e4f3fc; --site-brand: #145b80; }
  :root[data-theme="dark"] { color-scheme: dark; --site-bg: #101820; --site-text: #e8f0f5; --site-border: #2c3c48; --site-hover: #1c2b36; --site-active: #19384a; --site-brand: #72c6ec; }
  body { margin: 0; color: var(--site-text); background: var(--site-bg); font-family: system-ui, sans-serif; }
  .site-header { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 32px; padding: 12px 24px; border-bottom: 1px solid var(--site-border); background: var(--site-bg); }
  .site-header .brand { color: var(--site-brand); font-size: 24px; font-weight: 700; text-decoration: none; }
  .site-header nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .site-header nav a { display: block; padding: 10px 14px; border-radius: 6px; color: var(--site-text); text-decoration: none; line-height: 1.4; }
  .site-header nav a:hover { background: var(--site-hover); }
  .site-header nav a[aria-current="page"] { background: var(--site-active); color: var(--site-brand); font-weight: 700; }
  .site-header a:focus-visible, .site-header button:focus-visible, .site-header select:focus-visible { outline: 3px solid var(--site-brand); outline-offset: 3px; }
  .site-preferences { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .language-select, #site-theme { min-height: 38px; border: 1px solid var(--site-border); border-radius: 8px; background: var(--site-bg); color: var(--site-text); }
  .language-select { display: flex; align-items: center; padding-left: 9px; }
  .language-select select { border: 0; background: transparent; color: inherit; padding: 7px 8px 7px 5px; }
  #site-theme { width: 40px; padding: 0; cursor: pointer; }
  .theme-icon::before { content: "◐"; font-size: 18px; }
  :root[data-theme-preference="light"] .theme-icon::before { content: "☀"; }
  :root[data-theme-preference="dark"] .theme-icon::before { content: "☾"; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .placeholder { max-width: 960px; margin: 0 auto; padding: 48px 24px; }
  .placeholder h1 { margin: 0 0 16px; font-size: 28px; font-weight: 700; }
  .placeholder p { margin: 0; line-height: 1.7; }
  @media (max-width: 680px) { .site-header { gap: 8px 14px; padding: 10px 16px; } .site-header nav { order: 3; width: 100%; } .site-header nav a { padding: 8px 10px; font-size: 14px; } .language-select select { max-width: 92px; } }
</style>
