---
import "../styles/globals.css";

interface Props {
  title: string;
  titleEn: string;
  description: string;
  descriptionEn: string;
  active: "picker" | "contrast" | "oklch";
}

const { title, titleEn, description, descriptionEn, active } = Astro.props;
const menus = [
  { en: "Color picker", href: "/", id: "picker", key: "nav.picker", ko: "색상 선택기" },
  { en: "Contrast", href: "/contrast/", id: "contrast", key: "nav.contrast", ko: "명암비" },
  { en: "OKLCH", href: "/oklch/", id: "oklch", key: "nav.oklch", ko: "OKLCH" },
];
---

<!doctype html>
<html lang="ko" data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#28a8ea" />
    <meta
      name="description"
      content={description}
      data-ko={description}
      data-en={descriptionEn}
    />
    <link rel="icon" type="image/x-icon" href="/coloor-icon-ico.ico" />
    <title data-ko={`${title} | Coloor`} data-en={`${titleEn} | Coloor`}>{title} | Coloor</title>
    <script is:inline>
      (() => {
        const theme = localStorage.getItem("coloor:theme") || "system";
        let resolved = theme;
        if (theme === "system") {
          resolved = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePreference = theme;
        document.documentElement.classList.toggle("dark", resolved === "dark");
        const savedLanguage = localStorage.getItem("coloor:language");
        let language = navigator.language.toLowerCase().startsWith("ko") ? "ko" : "en";
        if (savedLanguage === "en" || savedLanguage === "ko") {
          language = savedLanguage;
        }
        document.documentElement.lang = language;
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <header class="flex flex-wrap items-center gap-x-8 gap-y-3 border-b bg-background/95 px-6 py-3 backdrop-blur supports-[backdrop-filter]:bg-background/75 max-[680px]:gap-x-3.5 max-[680px]:gap-y-2 max-[680px]:px-4 max-[680px]:py-2.5">
      <a
        class="inline-flex items-center gap-2.5 text-2xl font-bold tracking-tight text-primary no-underline"
        href="/"
        aria-label="Coloor 홈"
      >
        <img
          class="size-9 rounded-lg object-contain"
          src="/coloor-icon-transparent.png"
          width="36"
          height="36"
          alt=""
        />
        <span>Coloor</span>
      </a>
      <nav class="flex flex-wrap gap-1.5 max-[680px]:order-3 max-[680px]:w-full" aria-label="주 메뉴">
        {menus.map((menu) => (
          <a class:list={["rounded-md px-3.5 py-2 text-sm font-medium text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-accent-foreground max-[680px]:px-2.5", { "bg-secondary text-secondary-foreground": active === menu.id }]} href={menu.href} aria-current={active === menu.id ? "page" : undefined} data-i18n={menu.key} data-ko={menu.ko} data-en={menu.en}>
            {menu.ko}
          </a>
        ))}
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <label class="flex min-h-9 items-center rounded-md border bg-background pl-2 text-sm">
          <span class="sr-only" data-i18n="label.language" data-ko="언어" data-en="Language">언어</span>
          <span aria-hidden="true">文A</span>
          <select class="border-0 bg-transparent px-1.5 py-2 text-foreground outline-none max-[680px]:max-w-24" id="site-language" aria-label="언어">
            <option value="ko">한국어</option>
            <option value="en">English</option>
          </select>
        </label>
        <button class="inline-flex size-9 items-center justify-center rounded-md border bg-background text-foreground transition-colors hover:bg-accent" id="site-theme" type="button" aria-label="테마" title="테마"><span aria-hidden="true" class="theme-icon"></span><span class="sr-only theme-label">테마</span></button>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>

<script>
  import { applyTheme, getLanguage, getTheme, setLanguage } from "../utils/preferences";

  const languageSelect = document.querySelector<HTMLSelectElement>("#site-language");
  const themeButton = document.querySelector<HTMLButtonElement>("#site-theme");
  const media = matchMedia("(prefers-color-scheme: dark)");
  const themeOrder = ["system", "light", "dark"] as const;
  const labels = {
    en: { dark: "Dark theme", language: "Language", light: "Light theme", system: "System theme" },
    ko: { dark: "다크 테마", language: "언어", light: "라이트 테마", system: "시스템 테마" },
  };

  const renderLanguage = () => {
    const language = getLanguage();
    document.documentElement.lang = language;
    if (languageSelect) {
      languageSelect.value = language;
      languageSelect.ariaLabel = labels[language].language;
    }
    for (const element of document.querySelectorAll<HTMLElement>("[data-i18n]")) {
      element.textContent = element.dataset[language] ?? element.textContent;
    }
    const title = document.querySelector<HTMLTitleElement>("title[data-ko][data-en]");
    if (title) {
      title.textContent = title.dataset[language] ?? title.textContent;
    }
    const description = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    if (description) {
      description.content = description.dataset[language] ?? description.content;
    }
  };
  const renderTheme = () => {
    const language = getLanguage();
    const theme = getTheme();
    applyTheme(theme);
    if (themeButton) {
      const label = labels[language][theme];
      themeButton.ariaLabel = label;
      themeButton.title = label;
      const themeLabel = themeButton.querySelector<HTMLElement>(".theme-label");
      if (themeLabel) {
        themeLabel.textContent = label;
      }
    }
  };
  languageSelect?.addEventListener("change", () => {
    setLanguage(languageSelect.value === "en" ? "en" : "ko");
    renderLanguage();
    renderTheme();
  });
  themeButton?.addEventListener("click", () => {
    const current = getTheme();
    applyTheme(themeOrder[(themeOrder.indexOf(current) + 1) % themeOrder.length] ?? "system");
    renderTheme();
  });
  media.addEventListener("change", () => {
    if (getTheme() === "system") {
      renderTheme();
    }
  });
  renderLanguage();
  renderTheme();
</script>

<style is:global>
  .theme-icon::before { content: "◐"; font-size: 18px; }
  :root[data-theme-preference="light"] .theme-icon::before { content: "☀"; }
  :root[data-theme-preference="dark"] .theme-icon::before { content: "☾"; }
</style>
